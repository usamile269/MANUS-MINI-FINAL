{
  "version": 2,
  "builds": [
    { "src": "pair.html", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/pair.html" },
    { "source": "/pair", "destination": "/pair.html" },
    { "source": "/code", "destination": "https://web-production-b6970.up.railway.app/code" },
    { "source": "/active", "destination": "https://web-production-b6970.up.railway.app/active" },
    { "source": "/status", "destination": "https://web-production-b6970.up.railway.app/status" },
    { "source": "/site-settings", "destination": "https://web-production-b6970.up.railway.app/site-settings" },
    { "source": "/health", "destination": "https://web-production-b6970.up.railway.app/health" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
